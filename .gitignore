# ---- Compiler build output
/adac
/adac.exe
*.o
*.obj

# ---- Generated by the build (tools/embed turns runtime/*.adac into this file)
/src/prelude_data.c
/tools/embed
/tools/embed.exe

# ---- Executables produced by adac (programs you compile)
*.exe
# ...except the prebuilt examples, so they can be downloaded from the repo
!/examples/bin/*.exe

# ---- Test and benchmark artifacts
/tests/out/
/tests/cases/*.exe
/benchmarks/*_o0
/benchmarks/*_o2
/benchmarks/*.exe
__pycache__/
*.pyc

# ---- Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db