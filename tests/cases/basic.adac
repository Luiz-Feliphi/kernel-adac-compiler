// variables, type inference, const, float, functions, loops
const PI = (float) 3.14159;
String name = "Luiz";
int age = 18;
area = PI * (2 * 2);          // declared by inference (float)

int factorial(int n) {
    if (n <= 1) return 1;
    return n * factorial(n - 1);
}

float average(float a, float b) { return (a + b) / 2; }

void main() {
    age = age + 1;
    print(name, "\n", age);
    println();
    println("area = ", area);
    println(average(3, 4));
    println(factorial(10));
    int sum = 0;
    for (int i = 0 to 10; i++) sum += i;
    println("sum 0..10 = ", sum);
    for (int j to 3; j++) print(j, " ");
    println();
    int k = 0;
    for (int _; k < 3; k++) { }
    int n = 5;
    while (n > 0) { n -= 2; if (n == 1) break; }
    println("n=", n);
    bool ok = 3 < 4 && !(2 > 5);
    println(ok);
    println(7 / 2, " ", 7 % 3, " ", -7 / 2, " ", 1 << 10, " ", 0xFF & 15);
    println(2.5 * 2, " ", 10 / 4.0, " ", (int) 3.99, " ", (float) 7 / 2);
    char c = 'A';
    c++;
    println(c, " ", (int) c);
    String s = "abc" + 1 + 'x' + 2.5 + true;
    println(s);
    println(s.length(), " ", len(s), " ", s.charAt(1), " ", s.substring(1, 3), " ", "abc" == "ab" + "c");
    printf("%d + %d = %d | %.2f | %s | %c | %x\n", 2, 3, 5, 3.14159, "ok", 'z', 255);
    println(1 > 2 ? "yes" : "no");
    println("UTF-8: héllo ✓");
}
